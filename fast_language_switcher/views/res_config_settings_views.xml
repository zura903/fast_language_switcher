<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form_fls" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fast_language_switcher</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Fast Language Switcher"
                     string="Fast Language Switcher"
                     name="fast_language_switcher">

                    <block title="Keyboard Shortcut" name="fls_shortcut_container">
                        <setting id="fls_shortcut_setting"
                                 string="Language Switcher Shortcut"
                                 help="Shortcut to open the language switcher overlay. Click 'Change' then press the desired key combination (must include a modifier key). Default: Ctrl+L">
                            <field name="fls_shortcut" widget="fls_shortcut_input"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

</odoo>
